# MyHomeLab - copy to .env and fill real secrets (never commit .env)
# Database (Postgres) - MyHomeLab app
# Connection string override: ConnectionStrings__MyHomeLab
# Example: Host=localhost;Port=5432;Database=myhomelab;Username=postgres;Password=...
MYHOMELAB_DB_PASSWORD=CHANGE_ME

# RomM - MariaDB + IGDB
ROMM_DB_NAME=romm
ROMM_DB_USER=romm
ROMM_DB_PASSWORD=CHANGE_ME
ROMM_DB_ROOT_PASSWORD=CHANGE_ME
IGDB_CLIENT_ID=CHANGE_ME
IGDB_CLIENT_SECRET=CHANGE_ME
# Optional: STEAMGRIDDB_API_KEY, MOBYGAMES_API_KEY, SCREENSCRAPER_USER, etc.

# Kestrel HTTPS cert (if using custom pfx)
# ASPNETCORE_Kestrel__Certificates__Default__Path=certs/myhomelab.pfx
# ASPNETCORE_Kestrel__Certificates__Default__Password=CHANGE_ME
