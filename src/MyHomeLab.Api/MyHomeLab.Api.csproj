<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MyHomeLab.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="Microsoft.Management.Infrastructure" Version="3.0.0" />
    <PackageReference Include="System.Management" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyHomeLab.Application\MyHomeLab.Application.csproj" />
    <ProjectReference Include="..\MyHomeLab.Infrastructure\MyHomeLab.Infrastructure.csproj" />
    <ProjectReference Include="..\MyHomeLab.Domain\MyHomeLab.Domain.csproj" />
  </ItemGroup>

  <Target Name="CopyFrontendBuild" AfterTargets="Build" Condition="Exists('$(MSBuildThisFileDirectory)..\..\frontend\dist')">
    <ItemGroup>
      <_FrontendSource Include="$(MSBuildThisFileDirectory)..\..\frontend\dist\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_FrontendSource)" DestinationFiles="@(_FrontendSource->'$(MSBuildThisFileDirectory)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_FrontendSource)" DestinationFiles="@(_FrontendSource->'$(OutDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)..\MyHomeLab.Infrastructure\Terminal\NodePty\pty-bridge\**\*" Exclude="$(MSBuildThisFileDirectory)..\MyHomeLab.Infrastructure\Terminal\NodePty\pty-bridge\node_modules\.package-lock.json" Link="pty-bridge\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="EnsurePtyBridgeDeps" BeforeTargets="BeforeBuild" Condition="!Exists('$(MSBuildThisFileDirectory)..\MyHomeLab.Infrastructure\Terminal\NodePty\pty-bridge\node_modules\node-pty')">
    <Exec Command="npm ci --omit=dev" WorkingDirectory="$(MSBuildThisFileDirectory)..\MyHomeLab.Infrastructure\Terminal\NodePty\pty-bridge" ContinueOnError="WarnAndContinue">
      <Output TaskParameter="ExitCode" PropertyName="PtyNpmExitCode" />
    </Exec>
    <Message Text="PTY bridge dependencies missing and npm install failed (exit $(PtyNpmExitCode)). Run 'npm ci' in src/MyHomeLab.Infrastructure/Terminal/NodePty/pty-bridge manually; interactive terminal sessions will fail until then." Condition="'$(PtyNpmExitCode)' != '0'" Importance="high" />
  </Target>

</Project>
